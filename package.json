{
  "name": "imcjs",
  "version": "0.3.0-a1",
  "description": "Parse Imaging Mass Cytometry (IMC) MCD and TXT files in the browser or with Node",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepare": "npm run build",
    "coverage": "vitest run --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:api": "typedoc",
    "docs:preview": "npx vitepress preview docs",
    "docs": "npm run docs:api && npm run docs:build"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.8",
    "tsup": "^6.5.0",
    "typescript": "^6.0.3",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "canvas": "^3.2.3",
    "esbuild": "^0.25.0",
    "fast-xml-parser": "^5.8.0",
    "nanoid": "^6.0.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.28",
    "source-map-js": "^1.2.2",
    "typedoc": "^0.28.19",
    "vite": "^6.4.3",
    "vitepress": "^1.6.4",
    "xmldom": "^0.6.0"
  }
}
